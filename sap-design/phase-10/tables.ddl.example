// DESIGN TEMPLATE BUNDLE: split each define table into its own ADT object.
// Review target-release types, nullable projection and client/ETag semantics before activation.

// Tickets; public key TicketUUID; root Tickets
@EndUserText.label: 'Tickets'
@AbapCatalog.enhancement.category: #NOT_EXTENSIBLE
@AbapCatalog.tableCategory: #TRANSPARENT
@AbapCatalog.deliveryClass: #A
@AbapCatalog.dataMaintenance: #RESTRICTED
define table zit_ticket {
  key client : abap.clnt not null;
  key ticket_uuid : abap.raw(16) not null;
  ticket_number : abap.char(20);
  subject : abap.char(200);
  description : abap.string;
  status : abap.char(20);
  priority : abap.char(10);
  category : abap.char(40);
  requester_uuid : abap.raw(16);
  technician_uuid : abap.raw(16);
  has_technician_uuid : abap.char(1);
  asset_uuid : abap.raw(16);
  has_asset_uuid : abap.char(1);
  resolution : abap.string;
  has_resolution : abap.char(1);
  waiting_reason : abap.char(500);
  has_waiting_reason : abap.char(1);
  resolved_at : abap.dec(21,7);
  has_resolved_at : abap.char(1);
  closed_at : abap.dec(21,7);
  has_closed_at : abap.char(1);
  created_at : abap.dec(21,7);
  created_by : abap.char(80);
  last_changed_at : abap.dec(21,7);
  last_changed_by : abap.char(80);
  team_uuid : abap.raw(16);
  location_uuid : abap.raw(16);
  subcategory_uuid : abap.raw(16);
  has_subcategory_uuid : abap.char(1);
  response_minutes : abap.int4;
  resolution_minutes : abap.int4;
  warning_percent : abap.int4;
  slapolicy_revision : abap.int4;
  first_response_at : abap.dec(21,7);
  has_first_response_at : abap.char(1);
  resolution_started_at : abap.dec(21,7);
  slapaused_seconds : abap.int4;
  slapause_started_at : abap.dec(21,7);
  has_slapause_started_at : abap.char(1);
  waiting_reason_code : abap.char(500);
  has_waiting_reason_code : abap.char(1);
  escalation_level : abap.int4;
  escalation_target : abap.char(500);
  has_escalation_target : abap.char(1);
  last_escalated_at : abap.dec(21,7);
  has_last_escalated_at : abap.char(1);
  slalast_checked_at : abap.dec(21,7);
  has_slalast_checked_at : abap.char(1);
  // Internal concurrency timestamp; separate from public precision-zero audit time.
  local_changed_at : abp_locinst_lastchange_tstmpl;
}

