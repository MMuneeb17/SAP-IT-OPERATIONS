{
  "_version": "1.82.0",
  "sap.app": {
    "id": "itoms.helpdesk",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap-ux/fiori-elements-writer:lrop",
      "version": "3.1.60"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/odata/v4/it-operations/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.144.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "itoms.helpdesk.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "TicketsList",
          "target": "TicketsList"
        },
        {
          "pattern": "Tickets({key}):?query:",
          "name": "TicketsObjectPage",
          "target": "TicketsObjectPage"
        },
        {
          "pattern": "MySupport:?query:",
          "name": "MySupport",
          "target": "MySupport"
        },
        {
          "pattern": "Tickets({key})/Requester:?query:",
          "name": "RequesterObjectPage",
          "target": "RequesterObjectPage"
        },
        {
          "pattern": "Tickets({key})/Asset:?query:",
          "name": "AssetObjectPage",
          "target": "AssetObjectPage"
        }
      ],
      "targets": {
        "TicketsList": {
          "type": "Component",
          "id": "TicketsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Tickets",
              "variantManagement": "Page",
              "navigation": {
                "Tickets": {
                  "detail": {
                    "route": "TicketsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  },
                  "actions": {
                    "MySupport": {
                      "text": "{i18n>mySupport}",
                      "press": "itoms.helpdesk.ext.Navigation.mySupport",
                      "requiresSelection": false
                    }
                  }
                }
              }
            }
          }
        },
        "TicketsObjectPage": {
          "type": "Component",
          "id": "TicketsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Tickets",
              "navigation": {
                "Requester": {
                  "detail": {
                    "route": "RequesterObjectPage"
                  }
                },
                "Asset": {
                  "detail": {
                    "route": "AssetObjectPage"
                  }
                }
              },
              "content": {
                "header": {
                  "actions": {
                    "MySupport": {
                      "text": "{i18n>mySupport}",
                      "press": "itoms.helpdesk.ext.Navigation.mySupport",
                      "requiresSelection": false
                    },
                    "HelpDesk": {
                      "text": "{i18n>helpDesk}",
                      "press": "itoms.helpdesk.ext.Navigation.helpDesk"
                    }
                  }
                }
              }
            }
          }
        },
        "MySupport": {
          "type": "Component",
          "id": "MySupport",
          "name": "sap.fe.core.fpm",
          "options": {
            "settings": {
              "viewName": "itoms.helpdesk.ext.support.MySupport"
            }
          }
        },
        "RequesterObjectPage": {
          "type": "Component",
          "id": "RequesterObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/Tickets/Requester",
              "editableHeaderContent": false
            }
          }
        },
        "AssetObjectPage": {
          "type": "Component",
          "id": "AssetObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/Tickets/Asset",
              "editableHeaderContent": false
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
