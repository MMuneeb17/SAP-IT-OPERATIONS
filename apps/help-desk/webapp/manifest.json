{
  "_version": "1.82.0",
  "sap.app": {
    "id": "itoms.helpdesk",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap-ux/fiori-elements-writer:lrop",
      "version": "3.1.60"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/odata/v4/it-operations/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ObjectPage.ObjectPageController": {
            "controllerName": "itoms.helpdesk.ext.RelatedNavigation"
          }
        }
      }
    },
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.144.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.ui.layout": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "itoms.helpdesk.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "TicketsList",
          "target": "TicketsList"
        },
        {
          "pattern": "Tickets({key}):?query:",
          "name": "TicketsObjectPage",
          "target": "TicketsObjectPage"
        },
        {
          "pattern": "MySupport:?query:",
          "name": "MySupport",
          "target": "MySupport"
        },
        {
          "pattern": "Tickets({key})/Requester:?query:",
          "name": "RequesterObjectPage",
          "target": "RequesterObjectPage"
        },
        {
          "pattern": "Tickets({key})/Asset:?query:",
          "name": "AssetObjectPage",
          "target": "AssetObjectPage"
        },
        {
          "pattern": "Assets:?query:",
          "name": "AssetsList",
          "target": "AssetsList"
        },
        {
          "pattern": "Assets({key}):?query:",
          "name": "AssetsObjectPage",
          "target": "AssetsObjectPage"
        },
        {
          "pattern": "MyAssets:?query:",
          "name": "MyAssets",
          "target": "MyAssets"
        },
        {
          "pattern": "Materials:?query:",
          "name": "MaterialsList",
          "target": "MaterialsList"
        },
        {
          "pattern": "Materials({key}):?query:",
          "name": "MaterialsObjectPage",
          "target": "MaterialsObjectPage"
        },
        {
          "pattern": "Stocks:?query:",
          "name": "StocksList",
          "target": "StocksList"
        },
        {
          "pattern": "Stocks({key}):?query:",
          "name": "StocksObjectPage",
          "target": "StocksObjectPage"
        },
        {
          "pattern": "Reservations:?query:",
          "name": "ReservationsList",
          "target": "ReservationsList"
        },
        {
          "pattern": "Reservations({key}):?query:",
          "name": "ReservationsObjectPage",
          "target": "ReservationsObjectPage"
        },
        {
          "pattern": "StockTransactions:?query:",
          "name": "StockTransactionsList",
          "target": "StockTransactionsList"
        },
        {
          "pattern": "StockTransactions({key}):?query:",
          "name": "StockTransactionsObjectPage",
          "target": "StockTransactionsObjectPage"
        },
        {
          "pattern": "Repair:?query:",
          "name": "RepairWorkspace",
          "target": "RepairWorkspace"
        }
      ],
      "targets": {
        "TicketsList": {
          "type": "Component",
          "id": "TicketsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Tickets",
              "variantManagement": "Page",
              "navigation": {
                "Tickets": {
                  "detail": {
                    "route": "TicketsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  },
                  "actions": {
                    "MySupport": {
                      "text": "{i18n>mySupport}",
                      "press": "itoms.helpdesk.ext.Navigation.mySupport",
                      "requiresSelection": false
                    },
                    "AssetsList": {
                      "text": "{i18n>assetManagement}",
                      "press": "itoms.helpdesk.ext.Navigation.assets",
                      "requiresSelection": false
                    },
                    "Inventory": {
                      "text": "{i18n>inventory}",
                      "press": "itoms.helpdesk.ext.Navigation.inventory",
                      "requiresSelection": false
                    }
                  }
                }
              }
            }
          }
        },
        "TicketsObjectPage": {
          "type": "Component",
          "id": "TicketsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Tickets",
              "navigation": {
                "Requester": {
                  "detail": {
                    "route": "RequesterObjectPage"
                  }
                },
                "Asset": {
                  "detail": {
                    "route": "AssetObjectPage"
                  }
                },
                "Reservations": {
                  "detail": {
                    "route": "ReservationsObjectPage"
                  }
                },
                "StockTransactions": {
                  "detail": {
                    "route": "StockTransactionsObjectPage"
                  }
                }
              },
              "content": {
                "header": {
                  "actions": {
                    "MySupport": {
                      "text": "{i18n>mySupport}",
                      "press": "itoms.helpdesk.ext.Navigation.mySupport",
                      "requiresSelection": false
                    },
                    "HelpDesk": {
                      "text": "{i18n>helpDesk}",
                      "press": "itoms.helpdesk.ext.Navigation.helpDesk"
                    },
                    "ViewRequester": {
                      "text": "View requester",
                      "press": "itoms.helpdesk.ext.Navigation.requester"
                    },
                    "ViewAsset": {
                      "text": "View asset",
                      "press": "itoms.helpdesk.ext.Navigation.asset",
                      "enabled": "{= !!%{AssetUUID} }"
                    },
                    "AssetsList": {
                      "text": "{i18n>assetManagement}",
                      "press": "itoms.helpdesk.ext.Navigation.assets",
                      "requiresSelection": false
                    },
                    "Inventory": {
                      "text": "{i18n>inventory}",
                      "press": "itoms.helpdesk.ext.Navigation.inventory",
                      "requiresSelection": false
                    },
                    "RepairWorkspace": {
                      "text": "{i18n>repairWorkspace}",
                      "press": "itoms.helpdesk.ext.Navigation.repair",
                      "requiresSelection": false
                    }
                  }
                }
              }
            }
          }
        },
